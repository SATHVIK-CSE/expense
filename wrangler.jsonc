{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "expense",
  "main": "worker.py",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xpens-tracker-db",
      "database_id": "7c85b474-eca8-46d4-9415-d3de0f1f6fa5",
      "migrations_dir": "migrations"
    }
  ]
}
